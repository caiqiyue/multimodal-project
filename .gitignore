*.temp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
.Trashes
.Spotlight-V100
.fseventsd

# Harness 临时 handoff（不入 commit）
handoff-*.md
HANDOFF-*.md

# ============================================================
# 第十三优先级：IDE / 编辑器
# ============================================================
.idea/
.vscode/
!.vscode/extensions.json
!.vscode/settings.json.example
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# ============================================================
# 第十四优先级：第三方源码（按 项目总执行计划 §6 third_party/）
# ============================================================
third_party/*/
!third_party/.gitkeep
!third_party/README.md
clients/mobile-app/node_modules/
clients/wechat-mini/node_modules/

# ============================================================
# 第十五优先级：文档构建产物
# ============================================================
docs/_build/
docs/site/
*.pdf
*.docx

# ============================================================
# 第十六优先级：备份文件
# ============================================================
*.bak
*.backup
*.old
*.orig
*.rej
*.save

# ============================================================
# 第十七优先级：Nginx / systemd / 部署相关
# ============================================================
nginx/conf.d/*.local.conf
infra/nginx/*.local.conf
*.service.local
deploy-key*
server-deploy-key*

# ============================================================
# 第十八优先级：git 自身（防止 git 元数据嵌套）
# ============================================================
*.git
*.gitignore
# 例外：根目录的 .gitignore 必须 tracked（否则协作者看不到忽略规则）
!/.gitignore

# ============================================================
# 强制包含（即使是上面忽略的）
# ============================================================
!.gitkeep
!**/.gitkeep
!README.md
!LICENSE
!requirements.txt
!docs/项目总执行计划.md
!docs/服务器运维手册.md


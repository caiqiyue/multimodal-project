# =============================================================
# Multimodal-AI-Assistant 项目 .gitignore
# 依据：docs/项目总执行计划.md + docs/SECURITY.md + CLAUDE.md
# 核心原则：harness 文档不入 Git / 密钥不入 Git / 模型权重不入 Git / 数据集不入 Git
# =============================================================

# ============================================================
# 第一优先级：Harness 文档（CLAUDE.md 明确要求不入 Git）
# ============================================================
CLAUDE.md
AGENTS.md
init.sh
feature_list.json
claude-progress.md
session-handoff.md
NEXT_SESSION.md
clean-state-checklist.md
evidence/

# harness 政策文档（仍 git ignored）
docs/ARCHITECTURE.md
docs/SECURITY.md
docs/harness机制.md
# 注：项目总执行计划.md / 服务器运维手册.md 是项目文档，**入 Git**
# 它们不含密钥，是给所有协作者看的（harness 文档是给 AI agent 用的，性质不同）

# ============================================================
# 第二优先级：密钥 / 凭证 / Secret（绝不入 Git）
# ============================================================

# 信息.txt（含服务器密码 + minimax API key）
docs/信息.txt

# .env 系列
.env
.env.*
!.env.example
*.env

# SSH 私钥 / 公钥 / config
*.pem
*.key
*.pub.backup
id_rsa
id_ed25519
id_ecdsa
authorized_keys
known_hosts

# 证书
*.crt
*.cer
*.csr
*.pfx
*.p12

# API Key / Token / Secret 通用模式
# 匹配 sk-, ghp_, gho_, glpat-, AKIA, AIza, hf_, xai-, sk-ant-, sk-cp-, xoxb-, xoxp-
*sk-*
*sk_*
*api[-_]key*
*apikey*
*api[-_]secret*
*access[-_]token*
*refresh[-_]token*
*auth[-_]token*
*jwt[-_]secret*
*session[-_]secret*
*private[-_]key*
*client[-_]secret*
*consumer[-_]secret*

# 微信小程序
WX_APPID*
WX_APPSECRET*
WX_PRIVATE_KEY*
wechat-*.key
miniprogram-*.key

# 数据库
DATABASE_URL*
DB_PASSWORD*
*postgres://*:*@*

# 通用密码文件
password*
passwords*
credentials*
*.password
*.credentials

# Google / AWS / Aliyun / Azure 等云凭证
gcp-credentials.json
aws-credentials.json
aliyun-credentials.json
service-account*.json

# ============================================================
# 第三优先级：模型权重（CRITICAL — 单文件几 GB，绝不入库）
# ============================================================
models/
checkpoints/
*.safetensors
*.bin
*.pt
*.pth
*.gguf
*.onnx
*.h5
*.hdf5
*.ckpt
*.mar
*.tflite
*.pb
runs/
output/
ckpt/
*.pkl
*.pickle
training/outputs/
model-serving/cache/

# ============================================================
# 第四优先级：数据集（图片/视频/原始 JSONL）
# ============================================================
data/raw/
data/media/
data/samples/*.jpg
data/samples/*.jpeg
data/samples/*.png
data/samples/*.webp
data/samples/*.gif
data/samples/*.bmp
data/samples/*.mp4
data/samples/*.avi
data/samples/*.mov
data/samples/*.webm
data/samples/*.mkv
training/data/raw/
training/data/sft/*.jsonl
training/data/sft/*.json
training/data/sft/*.csv
training/data/sft/*.parquet
training/data/sft/*.arrow
training/data/grpo/*.jsonl
training/data/grpo/*.json
training/data/grpo/*.csv
training/data/grpo/*.parquet
training/data/grpo/*.arrow
backend/media/
backend/media/*
*.parquet
*.arrow
*.feather
*.tar
*.tar.gz
*.tgz
*.zip
*.7z
*.rar

# 保留 data 目录结构（.gitkeep 占位）
!data/.gitkeep
!data/samples/.gitkeep
!data/sft/.gitkeep
!data/grpo/.gitkeep

# ============================================================
# 第五优先级：媒体上传文件（用户上传到 FastAPI 的图片/视频）

{
  "name": "@multimodal/api-contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./auth": {
      "types": "./src/auth.ts",
      "default": "./dist/auth.js"
    },
    "./chat": {
      "types": "./src/chat.ts",
      "default": "./dist/chat.js"
    },
    "./media": {
      "types": "./src/media.ts",
      "default": "./dist/media.js"
    },
    "./conversation": {
      "types": "./src/conversation.ts",
      "default": "./dist/conversation.js"
    },
    "./user": {
      "types": "./src/user.ts",
      "default": "./dist/user.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --rewriteRelativeImportExtensions",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "vitest": "^2.1.5",
    "typescript": "^5.7.2"
  }
}
# =============================================================
# Multimodal AI Assistant Backend — env example
# 复制为 .env 并填入真实值（.env 必须 gitignored — 见 .gitignore 第二优先级）
# .env 文件权限必须 600（chmod 600 .env）
# Reference: docs/SECURITY.md §1.4
# =============================================================

# ---------- 服务标识 ----------
SERVICE_NAME=multimodal-backend
VERSION=0.1.0
ENVIRONMENT=development

# ---------- 网络绑定（SECURITY §2.2 — 仅 127.0.0.1） ----------
HOST=127.0.0.1
PORT=9000

# ---------- CORS（生产环境必须改成具体 origin，多个用逗号分隔） ----------
ALLOWED_ORIGINS=*

# ---------- JWT（feat-026 使用；生产环境必须用 32 字节随机） ----------
# 生成：python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=dev-only-secret-replace-in-prod-please-use-32-bytes-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ---------- 微信小程序（feat-037 就位后填；现在留空） ----------
# WX_APPID=
# WX_APPSECRET=